{
  "name": "cryptotrace-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CryptoTrace AI — Multi-Chain Blockchain Intelligence & VASP Attribution Forensics Suite",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "engine": "cd engine && python startup.py",
    "cli": "cd engine && python startup.py",
    "api": "cd api && uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "api:prod": "cd api && uvicorn main:app --host 0.0.0.0 --port $PORT",
    "dev:fullstack": "concurrently \"bun run dev\" \"bun run api\"",
    "setup:api": "cd api && pip install -r requirements.txt && cd ../engine && pip install -r requirements.txt"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^5.4.19"
  }
}
